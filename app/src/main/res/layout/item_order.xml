<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:padding="12dp"
    android:layout_margin="6dp"
    android:elevation="3dp">

    <ImageView
        android:id="@+id/imgOrderCake"
        android:layout_width="105dp"
        android:layout_height="125dp"
        android:scaleType="centerCrop"
        android:contentDescription="Ordered cake image" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/tvCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#8E174B" />

        <TextView
            android:id="@+id/tvCakeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chocolate Cake"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantity: 1"
            android:textColor="#555555"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delivery Date"
            android:textColor="#555555"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: Rs. 3500"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#C2185B"
            android:paddingTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Edit"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#C2185B" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Delete"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B3261E"
                android:layout_marginStart="5dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
